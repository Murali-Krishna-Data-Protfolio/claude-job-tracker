# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# ── Which profile to run (profiles/<id>.json) ──────────────────────────────────
# New user? Copy profiles/example.json -> profiles/<your_id>.json, fill it in,
# then set ACTIVE_PROFILE to that id. No source code changes needed.
ACTIVE_PROFILE=murali

# ── Required: Claude API (English-role classification) ────────────────────────
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Required: Gmail account that SENDS the daily digest ────────────────────────
# Must be a Gmail App Password (not your normal password):
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ── Optional: unlocks Adzuna (APEC, Monster, Cadremploi, RegionsJob +10 more) ──
# Free key at: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Optional: unlocks LinkedIn Jobs + Glassdoor via JSearch ────────────────────
# Free key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# ── Optional: cloud mirror + push notifications (python sync_cloud.py --setup) ─
# TELEGRAPH_ACCESS_TOKEN=
# TELEGRAPH_PAGE_PATH=
# NTFY_TOPIC=

# ── Optional: Google Drive sync (python sync_gdrive.py --setup) ────────────────
# Written automatically after setup — no need to fill in by hand.
# GDRIVE_FOLDER_ID=
# GDRIVE_FILE_ID=
# GDRIVE_VIEW_URL=
